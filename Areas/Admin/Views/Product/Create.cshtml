@model Product;
<div class="container">

    <div class="row">

        <h2>Create new Product</h2>

        <form method="post">

            <div class="text-danger" asp-validation-summary="All"> </div>

            <div class="form-group">
                <label for="exampleInputEmail1">Title</label>
                <input class="form-control" id="exampleInputEmail1" asp-for="Name" placeholder="Enter name">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="exampleInputEmail1">Description</label>
                <input class="form-control" id="exampleInputEmail1" asp-for="Description" placeholder="Enter description">
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="exampleInputEmail1">MainImageUrl</label>
                <input class="form-control" id="exampleInputEmail1" asp-for="MainImageUrl" placeholder="Enter main image URL">
                <span asp-validation-for="MainImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="exampleInputEmail1">HoverImageUrl</label>
                <input class="form-control" id="exampleInputEmail1" asp-for="HoverImageUrl" placeholder="Enter imageUrl">
                <span asp-validation-for="HoverImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="exampleInputEmail1">Price</label>
                <input class="form-control" id="exampleInputEmail1" asp-for="Price" placeholder="Enter price">
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="exampleInputEmail1">SKU</label>
                <input class="form-control" id="exampleInputEmail1" asp-for="SKU" placeholder="Enter SKU">
                <span asp-validation-for="SKU" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="exampleInputEmail1">CategoryId</label>
                <select asp-for="CategoryId">
                    <option value ="1">Stuff</option>
                    <option value ="2">Food</option>

                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>